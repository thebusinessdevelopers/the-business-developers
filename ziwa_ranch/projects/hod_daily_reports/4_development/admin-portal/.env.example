# OpenRouter
# Primary orchestrator model (daily brief final step, period analysis, weekly brief, urgency classifier fallback)
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Fast model for parallel sub-agents (daily-brief multi-agent pipeline)
OPENROUTER_MODEL_FAST=google/gemini-2.5-flash
# API key is read from Netlify site settings; do not commit
# OPENROUTER_API_KEY=

# Supabase (set in Netlify site settings)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Background function invoke URL (defaults to URL-relative; override for preview contexts if needed)
# NEXT_PUBLIC_SITE_URL=
